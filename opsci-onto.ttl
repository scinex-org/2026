@prefix ops: <https://scinex-org.github.io/2026/opsci-onto#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

<https://scinex-org.github.io/2026/opsci-onto#> rdf:type owl:Ontology ;
    dcterms:title "OpenSci Core Research Ontology (Diagram-led TBox)" ;
    dcterms:description "Core ontology mapping for research papers and ML experiments based on the provided structural diagram." ;
    owl:versionInfo "1.4" .

#################################################################
#    Classes
#################################################################

bibo:AcademicArticle rdf:type owl:Class ;
    rdfs:label "Research Paper" .

ops:DataProcessing rdf:type owl:Class ;
    rdfs:label "Data Processing" .

ops:Dataset rdf:type owl:Class ;
    rdfs:label "Dataset" .

ops:Experiment rdf:type owl:Class ;
    rdfs:label "Experiment" .

ops:Method rdf:type owl:Class ;
    rdfs:label "Method" .

ops:Result rdf:type owl:Class ;
    rdfs:label "Result" .

#################################################################
#    Object Properties 
#################################################################

# --- Relationships from bibo:AcademicArticle ---

dcterms:references rdf:type owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf (bibo:AcademicArticle ops:Method) ] ;
    rdfs:range bibo:AcademicArticle ;
    rdfs:label "references" .

ops:processData rdf:type owl:ObjectProperty ;
    rdfs:domain bibo:AcademicArticle ;
    rdfs:range ops:DataProcessing ;
    rdfs:label "processData" .

ops:usesData rdf:type owl:ObjectProperty ;
    rdfs:domain bibo:AcademicArticle ;
    rdfs:range ops:Dataset ;
    rdfs:label "usesData" .

ops:conducts rdf:type owl:ObjectProperty ;
    rdfs:domain bibo:AcademicArticle ;
    rdfs:range ops:Experiment ;
    rdfs:label "conducts" .

# --- Data Flow & Experimentation ---

ops:inputData rdf:type owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf (ops:DataProcessing ops:Experiment) ] ;
    rdfs:range ops:Dataset ;
    rdfs:label "inputData" .

ops:outputData rdf:type owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf (ops:DataProcessing ops:Experiment ops:Result) ] ;
    rdfs:range ops:Dataset ;
    rdfs:label "outputData" .

ops:employs rdf:type owl:ObjectProperty ;
    rdfs:domain ops:Experiment ;
    rdfs:range ops:Method ;
    rdfs:label "employs" .

ops:results rdf:type owl:ObjectProperty ;
    rdfs:domain ops:Experiment ;
    rdfs:range ops:Result ;
    rdfs:label "results" .

#################################################################
#    Data Properties 
#################################################################

ops:objective rdf:type owl:DatatypeProperty ;
    rdfs:domain bibo:AcademicArticle ;
    rdfs:range xsd:string ;
    rdfs:label "objective" .

dcterms:title rdf:type owl:DatatypeProperty ;
    rdfs:domain bibo:AcademicArticle ;
    rdfs:range xsd:string ;
    rdfs:label "title" .

dcterms:creator rdf:type owl:DatatypeProperty ;
    rdfs:domain bibo:AcademicArticle ;
    rdfs:range xsd:string ;
    rdfs:label "creator" .

bibo:doi rdf:type owl:DatatypeProperty ;
    rdfs:domain bibo:AcademicArticle ;
    rdfs:range xsd:string ;
    rdfs:label "doi" .

dcterms:date rdf:type owl:DatatypeProperty ;
    rdfs:domain bibo:AcademicArticle ;
    rdfs:range xsd:date ;
    rdfs:label "date" .
