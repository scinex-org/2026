@prefix snx: <https://scinex-org.github.io/2026/scinex-core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

<https://scinex-org.github.io/2026/scinex-core#> rdf:type owl:Ontology ;
    dcterms:title "SciNex Core Research Ontology" ;
    dcterms:description "Core TBox for research data representation based on the SciNex framework." ;
    owl:versionInfo "1.5" .

#################################################################
#    Classes
#################################################################

bibo:AcademicArticle rdf:type owl:Class ;
    rdfs:label "Research Paper" .

snx:DataProcessing rdf:type owl:Class ;
    rdfs:label "Data Processing" .

snx:Dataset rdf:type owl:Class ;
    rdfs:label "Dataset" .

snx:Experiment rdf:type owl:Class ;
    rdfs:label "Experiment" .

snx:Method rdf:type owl:Class ;
    rdfs:label "Method" .

snx:Result rdf:type owl:Class ;
    rdfs:label "Result" .

#################################################################
#    Object Properties
#################################################################

# --- Relationships from bibo:AcademicArticle ---

dcterms:references rdf:type owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf (bibo:AcademicArticle snx:Method) ] ;
    rdfs:range bibo:AcademicArticle ;
    rdfs:label "references" .

snx:processData rdf:type owl:ObjectProperty ;
    rdfs:domain bibo:AcademicArticle ;
    rdfs:range snx:DataProcessing ;
    rdfs:label "processData" .

snx:usesData rdf:type owl:ObjectProperty ;
    rdfs:domain bibo:AcademicArticle ;
    rdfs:range snx:Dataset ;
    rdfs:label "usesData" .

snx:conducts rdf:type owl:ObjectProperty ;
    rdfs:domain bibo:AcademicArticle ;
    rdfs:range snx:Experiment ;
    rdfs:label "conducts" .

# --- Data Flow & Experimentation ---

snx:inputData rdf:type owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf (snx:DataProcessing snx:Experiment) ] ;
    rdfs:range snx:Dataset ;
    rdfs:label "inputData" .

snx:outputData rdf:type owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf (snx:DataProcessing snx:Experiment snx:Result) ] ;
    rdfs:range snx:Dataset ;
    rdfs:label "outputData" .

snx:employs rdf:type owl:ObjectProperty ;
    rdfs:domain snx:Experiment ;
    rdfs:range snx:Method ;
    rdfs:label "employs" .

snx:results rdf:type owl:ObjectProperty ;
    rdfs:domain snx:Experiment ;
    rdfs:range snx:Result ;
    rdfs:label "results" .

#################################################################
#    Data Properties (Literals)
#################################################################

# --- Paper Metadata ---

snx:objective rdf:type owl:DatatypeProperty ;
    rdfs:domain bibo:AcademicArticle ;
    rdfs:range xsd:string ;
    rdfs:label "objective" .

dcterms:title rdf:type owl:DatatypeProperty ;
    rdfs:domain bibo:AcademicArticle ;
    rdfs:range xsd:string ;
    rdfs:label "title" .

dcterms:creator rdf:type owl:DatatypeProperty ;
    rdfs:domain bibo:AcademicArticle ;
    rdfs:range xsd:string ;
    rdfs:label "creator" .

bibo:doi rdf:type owl:DatatypeProperty ;
    rdfs:domain bibo:AcademicArticle ;
    rdfs:range xsd:string ;
    rdfs:label "doi" .

dcterms:date rdf:type owl:DatatypeProperty ;
    rdfs:domain bibo:AcademicArticle ;
    rdfs:range xsd:date ;
    rdfs:label "date" .

# --- Dataset Metadata ---

snx:feature rdf:type owl:DatatypeProperty ;
    rdfs:domain snx:Dataset ;
    rdfs:range xsd:string ;
    rdfs:comment "List of features/attributes in the dataset." .

snx:label rdf:type owl:DatatypeProperty ;
    rdfs:domain snx:Dataset ;
    rdfs:range xsd:string ;
    rdfs:comment "The target variable or label used for training/testing." .

snx:datasetName rdf:type owl:DatatypeProperty ;
    rdfs:domain snx:Dataset ;
    rdfs:range xsd:string .

snx:sampleSize rdf:type owl:DatatypeProperty ;
    rdfs:domain snx:Dataset ;
    rdfs:range xsd:integer .
