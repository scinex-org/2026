@prefix snx: <https://scinex-org.github.io/2026/scinex-core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

<https://scinex-org.github.io/2026/scinex-core#> rdf:type owl:Ontology ;
    dcterms:title "SciNex Core Research Ontology (Refined Diagram Update)" ;
    owl:versionInfo "1.7" .

#################################################################
#    Classes
#################################################################

bibo:AcademicArticle rdf:type owl:Class ;
    rdfs:label "Research Paper" .

snx:Data rdf:type owl:Class ;
    rdfs:label "Data" .

snx:Experiment rdf:type owl:Class ;
    rdfs:label "Experiment" .

snx:Method rdf:type owl:Class ;
    rdfs:label "Method" .

snx:Algorithm rdf:type owl:Class ;
    rdfs:label "Algorithm" .

#################################################################
#    Object Properties
#################################################################

# --- Relationships from bibo:AcademicArticle ---
snx:usesData rdf:type owl:ObjectProperty ;
    rdfs:domain bibo:AcademicArticle ;
    rdfs:range snx:Data .

snx:conducts rdf:type owl:ObjectProperty ;
    rdfs:domain bibo:AcademicArticle ;
    rdfs:range snx:Experiment .

# --- Relationships from Data ---
dcterms:references rdf:type owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf (snx:Data snx:Method) ] ;
    rdfs:range bibo:AcademicArticle ;
    rdfs:comment "Data or Method referencing a Paper (reference)." .

# --- Relationships from Experiment ---
snx:inputData rdf:type owl:ObjectProperty ;
    rdfs:domain snx:Experiment ;
    rdfs:range snx:Data .

snx:outputData rdf:type owl:ObjectProperty ;
    rdfs:domain snx:Experiment ;
    rdfs:range snx:Data .

snx:employs rdf:type owl:ObjectProperty ;
    rdfs:domain snx:Experiment ;
    rdfs:range snx:Method .

# --- Relationships from Method ---
snx:algorithm rdf:type owl:ObjectProperty ;
    rdfs:domain snx:Method ;
    rdfs:range snx:Algorithm .

#################################################################
#    Data Properties (Literals)
#################################################################

# --- bibo:AcademicArticle Metadata ---
snx:objective rdf:type owl:DatatypeProperty ;
    rdfs:domain bibo:AcademicArticle ;
    rdfs:range xsd:string .

dcterms:title rdf:type owl:DatatypeProperty ;
    rdfs:domain bibo:AcademicArticle ;
    rdfs:range xsd:string .

dcterms:creator rdf:type owl:DatatypeProperty ;
    rdfs:domain bibo:AcademicArticle ;
    rdfs:range xsd:string .

bibo:doi rdf:type owl:DatatypeProperty ;
    rdfs:domain bibo:AcademicArticle ;
    rdfs:range xsd:string .

dcterms:date rdf:type owl:DatatypeProperty ;
    rdfs:domain bibo:AcademicArticle ;
    rdfs:range xsd:date .

# --- Data Details ---
rdfs:label rdf:type owl:DatatypeProperty ;
    rdfs:domain snx:Data ;
    rdfs:range xsd:string .

snx:feature rdf:type owl:DatatypeProperty ;
    rdfs:domain snx:Data ;
    rdfs:range xsd:string .

snx:sampleSize rdf:type owl:DatatypeProperty ;
    rdfs:domain snx:Data ;
    rdfs:range xsd:string .

# --- Experiment Details ---
snx:matric rdf:type owl:DatatypeProperty ;
    rdfs:domain snx:Experiment ;
    rdfs:range xsd:string ;
    rdfs:label "metric/matric" .

# --- Method Details ---
snx:setting rdf:type owl:DatatypeProperty ;
    rdfs:domain snx:Method ;
    rdfs:range xsd:string .
